-- Phase 7: Server-Side Rate Limiting via Supabase RPC (Revised)
-- Note: This is an application-level, email-based rate limiter to mitigate brute force.
-- It does NOT use IP-based rate limiting because Supabase Postgres RPCs cannot 
-- reliably access the client's true IP (only the PostgREST server IP).
-- Proper IP rate-limiting must be implemented at the WAF/Edge layer (e.g. Vercel Edge).

CREATE TABLE IF NOT EXISTS public.login_attempts (
    email TEXT PRIMARY KEY,
    attempts INT DEFAULT 0,
    locked_until TIMESTAMP WITH TIME ZONE,
    last_attempt TIMESTAMP WITH TIME ZONE DEFAULT now()
);

-- Secure the table (strictly restricted to SECURITY DEFINER functions)
ALTER TABLE public.login_attempts ENABLE ROW LEVEL SECURITY;

-- 1. Function to check if a user is currently locked out
CREATE OR REPLACE FUNCTION public.check_login_status(p_email TEXT)
RETURNS JSON AS $$
DECLARE
  v_attempts INT;
  v_locked_until TIMESTAMP WITH TIME ZONE;
  v_email TEXT;
BEGIN
  -- Input Validation
  IF p_email IS NULL OR length(trim(p_email)) < 5 OR length(trim(p_email)) > 255 THEN
    RAISE EXCEPTION 'Invalid email input';
  END IF;

  v_email := lower(trim(p_email));

  -- Cleanup expired locks opportunistically
  DELETE FROM public.login_attempts WHERE locked_until <= now();

  SELECT attempts, locked_until INTO v_attempts, v_locked_until 
  FROM public.login_attempts 
  WHERE email = v_email;
  
  IF v_locked_until > now() THEN
    RETURN json_build_object('allowed', false, 'locked_until', v_locked_until);
  END IF;
  
  RETURN json_build_object('allowed', true);
END;
$$ LANGUAGE plpgsql SECURITY DEFINER SET search_path = public;

REVOKE ALL ON FUNCTION public.check_login_status(TEXT) FROM public;
GRANT EXECUTE ON FUNCTION public.check_login_status(TEXT) TO anon, authenticated;

-- 2. Function to record a failed login attempt
CREATE OR REPLACE FUNCTION public.record_failed_login(p_email TEXT)
RETURNS JSON AS $$
DECLARE
  v_attempts INT;
  v_locked_until TIMESTAMP WITH TIME ZONE;
  v_email TEXT;
BEGIN
  IF p_email IS NULL OR length(trim(p_email)) < 5 OR length(trim(p_email)) > 255 THEN
    RAISE EXCEPTION 'Invalid email input';
  END IF;

  v_email := lower(trim(p_email));

  INSERT INTO public.login_attempts (email, attempts, last_attempt)
  VALUES (v_email, 1, now())
  ON CONFLICT (email) DO UPDATE 
  SET attempts = public.login_attempts.attempts + 1,
      last_attempt = now()
  RETURNING attempts INTO v_attempts;

  -- Progressive throttling
  IF v_attempts >= 6 THEN
    v_locked_until := now() + interval '1 hour';
  ELSIF v_attempts >= 3 THEN
    v_locked_until := now() + interval '5 minutes';
  END IF;

  IF v_locked_until IS NOT NULL THEN
    UPDATE public.login_attempts 
    SET locked_until = v_locked_until 
    WHERE email = v_email;
    RETURN json_build_object('locked', true, 'locked_until', v_locked_until);
  END IF;

  RETURN json_build_object('locked', false, 'attempts', v_attempts);
END;
$$ LANGUAGE plpgsql SECURITY DEFINER SET search_path = public;

REVOKE ALL ON FUNCTION public.record_failed_login(TEXT) FROM public;
GRANT EXECUTE ON FUNCTION public.record_failed_login(TEXT) TO anon, authenticated;

-- 3. Function to reset attempts upon successful login
CREATE OR REPLACE FUNCTION public.reset_login_attempts(p_email TEXT)
RETURNS VOID AS $$
DECLARE
  v_email TEXT;
  v_auth_email TEXT;
BEGIN
  IF p_email IS NULL OR length(trim(p_email)) < 5 OR length(trim(p_email)) > 255 THEN
    RAISE EXCEPTION 'Invalid email input';
  END IF;

  v_email := lower(trim(p_email));
  
  -- Prevent authenticated attackers from resetting other accounts' limits
  v_auth_email := lower(trim(current_setting('request.jwt.claims', true)::json ->> 'email'));
  IF v_auth_email IS NULL OR v_email != v_auth_email THEN
    RAISE EXCEPTION 'Unauthorized to reset attempts for this account';
  END IF;

  DELETE FROM public.login_attempts WHERE email = v_email;
END;
$$ LANGUAGE plpgsql SECURITY DEFINER SET search_path = public;

REVOKE ALL ON FUNCTION public.reset_login_attempts(TEXT) FROM public;
-- CRITICAL FIX: Only authenticated users can reset their attempts!
GRANT EXECUTE ON FUNCTION public.reset_login_attempts(TEXT) TO authenticated;
